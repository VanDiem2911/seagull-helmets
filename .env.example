# MongoDB connection (local docker-compose, `npm run db:dev`, or an Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/seagull_vn

# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shop contact channels (see lib/site.ts for defaults)
NEXT_PUBLIC_ZALO_PHONE=0938810557
NEXT_PUBLIC_MESSENGER_URL=https://m.me/seagull.helmets
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/seagull.helmets

# Bank transfer / VietQR (shown on the order page when set). BANK_ID is the VietQR bank code, e.g. VCB, ACB, MB
BANK_ID=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
